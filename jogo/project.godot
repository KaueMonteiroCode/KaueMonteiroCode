; Arquivo de configuracao do Godot 4.

config_version=5

[application]

config/name="Mesa de Aventura"
run/main_scene="res://cenas/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Jogo="*res://scripts/autoload/jogo.gd"
Narrador="*res://scripts/autoload/narrador.gd"
Toque="*res://scripts/autoload/toque.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[layer_names]

2d_physics/layer_1="paredes"
2d_physics/layer_2="jogador"
2d_physics/layer_3="inimigos"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.07, 0.1, 1)
